{
  "expo": {
    "name": "ممنون",
    "slug": "mumnun",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mumnun",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": ["android"],
    "android": {
      "package": "com.mumnun.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-bg.png"
      },
      "splash": {
        "image": "./assets/splash.png",
        "backgroundColor": "#1e40af"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "mumnun", "host": "request" },
            { "scheme": "https", "host": "mumnun.app" }
          ]
        }
      ]
    },
    "plugins": [
      ["expo-build-properties", {
        "android": {
          "minSdkVersion": 24,
          "targetSdkVersion": 35,
          "compileSdkVersion": 35,
          "kotlinVersion": "2.0.21",
          "enableProguardInReleaseBuilds": true,
          "enableR8": true,
          "useLegacyPackaging": false
        }
      }],
      ["expo-location", {
        "locationAlwaysAndWhenInUsePermission": "يستخدم التطبيق الموقع لتتبع الرحلات في الخلفية",
        "locationWhenInUsePermission": "يستخدم التطبيق الموقع لعرض موقعك على الخريطة"
      }],
      ["expo-notifications", {
        "color": "#1e40af",
        "defaultChannel": "default",
        "enableBackgroundRemoteNotifications": true
      }],
      ["expo-splash-screen", {
        "image": "./assets/splash.png",
        "backgroundColor": "#1e40af",
        "imageWidth": 200
      }],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": ""
      }
    },
    "owner": "mumnun",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": ""
    }
  }
}
